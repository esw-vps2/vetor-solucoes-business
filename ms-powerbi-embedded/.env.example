# Azure AD — App Registration
PB_CLIENT_ID=00000000-0000-0000-0000-000000000000
PB_CLIENT_SECRET=seu-client-secret-aqui
PB_TENANT_ID=00000000-0000-0000-0000-000000000000
PB_SERVICE_PRINCIPAL=00000000-0000-0000-0000-000000000000

# Power BI API
PB_BASE_URL=https://api.powerbi.com/v1.0
PB_AUTHORITY_URL=https://login.microsoftonline.com/

# Master User (modo alternativo de autenticação)
PB_USERNAME=usuario@exemplo.com
PB_PASSWORD=senha-segura-aqui

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Autenticação interna (obrigatória em produção)
API_KEY=gere-uma-chave-segura-aqui
ENVIRONMENT=production