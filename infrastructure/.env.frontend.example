# Runtime
NODE_ENV=development

# Frontend
FRONTEND_PORT=3000
# Loopback makes the browser call /api/v1 on the page origin. Compose proxies that
# path to http://backend:3001. A non-loopback URL is called directly unless
# NEXT_PUBLIC_API_PROXY=true (same-origin /api/v1 through Next.js rewrites).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Set to true when the public site and API share one origin (for example
# https://vps2.com.br) and Next.js proxies /api/v1 to API_INTERNAL_URL.
# Also set client_max_body_size in infrastructure/nginx.vps.example.conf when
# nginx terminates TLS in front of the API.
NEXT_PUBLIC_API_PROXY=false
# Runtime origin for Next.js rewrites in Docker (not exposed to the browser).
API_INTERNAL_URL=http://backend:3001

# Public WhatsApp click-to-chat number (digits only, country code + subscriber).
# Leave empty to hide the leadpage widget. This value is public in the browser.
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999
