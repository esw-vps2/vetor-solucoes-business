# Runtime
NODE_ENV=development

# Backend
PORT=3001
# Browser origins allowed to call the API with credentials.
# Include the local hosts when /etc/hosts points vps2.com.br or app.vps2.com.br at this machine.
CORS=http://localhost:3000,http://vps2.com.br:3000,http://app.vps2.com.br:3000,https://portal.vps2.com.br,https://vps2.com.br,https://app.vps2.com.br

# PostgreSQL
# Discrete POSTGRES_* values live in .env.database.
# Inside Compose, the host is the postgres service name.
DATABASE_URL=postgresql://vetor:vetor@postgres:5432/vetor

# Logging
LOG_DIR=logs
LOG_MAX_SIZE=200m
LOG_MAX_FILES=30d

# JWT is required only when authentication is implemented; change these values in shared environments.
JWT_SECRET=dev-only-change-me-in-production-use-long-random-string
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_SECONDS=604800

# Email (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-smtp-user
MAIL_PASSWORD=change-me
MAIL_FROM=noreply@example.com
MAIL_SECURE=false

# Product email and portal
FORM_CONTACT=contato@vetor.tech
# Change BOOTSTRAP_ADMIN_PASSWORD in shared and production environments.
BOOTSTRAP_ADMIN_EMAIL=admin@vetor.tech
BOOTSTRAP_ADMIN_PASSWORD=god@2025
BOOTSTRAP_ADMIN_TENANT_NAME=VETOR
BOOTSTRAP_ADMIN_TENANT_SLUG=vetor
PORTAL_ROUTE=/portal
PASSWORD_RESET_TOKEN_EXPIRES_IN=15m
# Lifetime of the Editar usuário Reset Login link. Public recovery stays on PASSWORD_RESET_TOKEN_EXPIRES_IN.
ADMIN_PASSWORD_RESET_LINK_EXPIRES_IN=30m
MFA_EMAIL_TOKEN_EXPIRES_IN=30m
# Digit count for the portal MFA code. Leave unset until that product decision
# is recorded. Login returns 503 and sends no email when this is missing or
# is not an integer from 1 to 32.
MFA_EMAIL_TOKEN_DIGITS=6
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW=15m
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW=15m
AUTH_REFRESH_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_WINDOW=15m
USER_CREATE_RATE_LIMIT_MAX=5
USER_CREATE_RATE_LIMIT_WINDOW=15m
PASSWORD_RESET_RATE_LIMIT_MAX=3
PASSWORD_RESET_RATE_LIMIT_WINDOW=15m
PASSWORD_RESET_VERIFY_RATE_LIMIT_MAX=5
PASSWORD_RESET_VERIFY_RATE_LIMIT_WINDOW=15m

# Tenant files volume (infrastructure/repository/files inside Compose)
TENANT_FILES_ROOT=/app/files

# Power BI Embedded (Nest → ms-powerbi-embedded). Never expose these to NEXT_PUBLIC_*.
POWERBI_EMBEDDED_URL=http://powerbi:8000
POWERBI_EMBEDDED_API_KEY=change-me-powerbi-api-key
POWERBI_EMBEDDED_TIMEOUT=15000
POWERBI_EMBED_TOKEN_RATE_LIMIT_MAX=30
POWERBI_EMBED_TOKEN_RATE_LIMIT_WINDOW=15m
POWERBI_PROXY_RATE_LIMIT_MAX=60
POWERBI_PROXY_RATE_LIMIT_WINDOW=15m

# Tenant notes (AES-256-GCM). Base64 of exactly 32 random bytes. Change before shared use.
# Generate: openssl rand -base64 32
# Dev-only placeholder below is 32 zero bytes encoded as base64 — replace it.
NOTES_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# AI agent chat. Placeholders only. Replace before shared or production use.
# RabbitMQ stays on the Compose network. Do not publish AMQP or the management UI.
RABBITMQ_URL=amqp://vetor:change-me@rabbitmq:5672
RABBITMQ_QUEUE=ai.runs
RABBITMQ_RETRY_LIMIT=3
RABBITMQ_RETRY_BACKOFF=1000,2000,4000
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/example-model
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
AI_AGENT_SYSTEM_INSTRUCTIONS=You are the Vetor assistant. Answer only from the current conversation.
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_HISTORY_MESSAGES=20
AI_PROVIDER_TIMEOUT_MS=60000
AI_STREAM_IDLE_TIMEOUT_MS=20000
AI_MAX_CONCURRENT_RUNS=2
AI_MAX_CONCURRENT_RUNS_PER_TENANT=1
AI_MAX_SSE_CONNECTIONS=100
AI_MAX_SSE_CONNECTIONS_PER_OWNER=4
AI_MAX_PROVIDER_RESPONSE_BYTES=1048576
AI_MAX_MESSAGE_CHARS=8000
AI_RUN_LEASE_MS=120000
AI_OUTBOX_POLL_MS=1000
AI_WORKER_HEALTH_PORT=3002
AI_SSE_HEARTBEAT_MS=15000
AI_MESSAGE_RATE_LIMIT_MAX=20
AI_MESSAGE_RATE_LIMIT_WINDOW=15m
AI_CONVERSATION_RATE_LIMIT_MAX=20
AI_CONVERSATION_RATE_LIMIT_WINDOW=15m
AI_WORKER_MEMORY=512m
AI_WORKER_CPUS=1
