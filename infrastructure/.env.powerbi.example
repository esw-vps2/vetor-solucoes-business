# Azure AD app registration placeholders. Replace locally. Do not commit real secrets.
PB_CLIENT_ID=00000000-0000-0000-0000-000000000000
PB_CLIENT_SECRET=change-me-powerbi-client-secret
PB_TENANT_ID=00000000-0000-0000-0000-000000000000
PB_SERVICE_PRINCIPAL=00000000-0000-0000-0000-000000000000

# Microsoft Power BI API
PB_BASE_URL=https://api.powerbi.com/v1.0
PB_AUTHORITY_URL=https://login.microsoftonline.com/

# Master-user fallback used by the Python service. Leave placeholders in shared environments.
PB_USERNAME=powerbi-user@example.com
PB_PASSWORD=change-me-powerbi-password

# Redis token cache (Compose service name)
REDIS_HOST=redis
REDIS_PORT=6379

# Must match backend POWERBI_EMBEDDED_API_KEY
API_KEY=change-me-powerbi-api-key
ENVIRONMENT=development
