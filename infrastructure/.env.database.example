# Local PostgreSQL (Docker Compose)
# Copy to .env.database and change values for shared environments.
# The official image reads POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB
# on first cluster initialization.
# Changing these values later requires wiping infrastructure/repository/postgres.

# Inside Compose, POSTGRES_HOST is the postgres service name.
# Use localhost when the backend runs on the host against the published port.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vetor
POSTGRES_PASSWORD=vetor
POSTGRES_DB=vetor
